# 复制为 .env.localhost 并按需修改；.env.localhost 本身已在 .gitignore 中排除，不会被提交。
# 仅在 ENV=localhost 时被读取；ENV=prod 时完全忽略本文件，所有配置必须来自真实 OS 环境变量。

# --- MySQL（远程 8.0+）---
OKX_APP_MYSQL_HOST=127.0.0.1
OKX_APP_MYSQL_PORT=3306
OKX_APP_MYSQL_USER=okx_app
OKX_APP_MYSQL_PASSWORD=
OKX_APP_MYSQL_DATABASE=okx_app

# --- Redis ---
OKX_APP_REDIS_HOST=127.0.0.1
OKX_APP_REDIS_PORT=6379
OKX_APP_REDIS_DB=0

OKX_APP_DEBUG=false

# --- M23 经济日历鉴权（可选；未配置时应用返回空数据集）---
OKX_APP_OKX_API_KEY=
OKX_APP_OKX_API_SECRET=
OKX_APP_OKX_API_PASSPHRASE=

# --- Nacos ---
# ENV=localhost 下 Nacos 被强制禁用（无论以下变量取值如何），完全不连接，
# MySQL/Redis 使用上面的 OKX_APP_MYSQL_*/OKX_APP_REDIS_* 值。
# 这些变量只在 ENV=prod 时才会被读取（此时也不会加载本文件，须来自真实 OS 环境变量），
# 用于让进程找到并登录 Nacos；MySQL/Redis 的 host/user/password 等会被 Nacos 远程配置
# （NACOS_DATA_ID 指向的 YAML，含 database.* 与 redis.* 两个顶层键）覆盖，见 backend/README.md。
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE_ID=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_DATA_ID=okx.yaml
NACOS_GROUP=DEFAULT_GROUP
NACOS_TIMEOUT_MS=5000
